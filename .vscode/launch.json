{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Coding Harness (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/playground"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Run with the offline mock provider",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/playground"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile",
      "env": {
        "HARNESS_DEV_PROVIDER": "mock"
      },
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
